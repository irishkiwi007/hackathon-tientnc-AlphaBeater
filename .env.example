# Google AI Studio / Gemini API
GEMINI_API_KEY=replace_me
GEMMA_MODEL=gemma-4-31b-it

# Featherless AI - independent fallback provider when Gemma is unavailable
FEATHERLESS_API_KEY=replace_me
FEATHERLESS_MODEL=openai/gpt-oss-120b
FEATHERLESS_BACKUP_MODEL=deepseek-ai/DeepSeek-V3.1

# Alpaca paper-trading credentials (never commit real values)
ALPACA_API_KEY=replace_me
ALPACA_SECRET_KEY=replace_me
ALPACA_PAPER=true

# Both switches default to false. They can never enable live trading.
ENABLE_PAPER_ORDERS=false
ENABLE_AUTOMATIC_EXITS=false
